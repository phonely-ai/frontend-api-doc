{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Phonely Documentation",
  "colors": {
    "primary": "#6B0099",
    "light": "#9B30FF",
    "dark": "#4A0069"
  },
  "styling": {
